{
	"name": "@esp32-computador-de-bordo/app",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"engines": {
		"bun": ">=1.2.0"
	},
	"scripts": {
		"dev": "bun --watch src/index.ts",
