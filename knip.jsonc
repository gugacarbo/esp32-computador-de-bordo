{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"workspaces": {
		".": {
			"entry": ["scripts/**/*.ts"],
			"project": ["scripts/**/*.ts"]
		},
		"apps/web": {
			"project": ["src/**/*", "scripts/**/*"],
			"ignoreExportsUsedInFile": true
		}
	},
	"ignore": [],
	"ignoreDependencies": [],
	"ignoreBinaries": ["pio"]
}
