{
	"name": "esp32-computador-de-bordo",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"engines": {
		"bun": ">=1.2.0"
	},
	"scripts": {
		"dev": "bun run --filter '@esp32-computador-de-bordo/app' dev",
		"build": "bun run --filter '*' build",
		"typecheck": "tsc --noEmit -p tsconfig.tools.json && bun run --filter '*' typecheck",
		"test": "bun run --filter '*' test",
		"test:watch": "bun run --filter '*' test:watch",
		"test:coverage": "bun run --filter '*' test:coverage",
		"test-staged": "bun scripts/test-staged.ts",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"firmware:build": "pio run -d apps/firmware -e esp32doit-devkit-v1",
		"firmware:test": "pio test -d apps/firmware -e native",
		"firmware:test:web": "playwright test -c playwright.firmware.config.ts",
		"lint": "biome lint .",
		"format": "biome format .",
		"check": "biome check .",
		"format:md": "prettier --write \"**/*.{md,yml,yaml,sh}\"",
		"format:check": "prettier --check \"**/*.{md,yml,yaml,sh}\"",
		"spell": "cspell lint \"**/*.{ts,tsx,md,json,yaml}\"",
		"spell:fix": "bun run spell",
		"architecture:check": "bun scripts/architecture-check.ts",
		"docs:check": "scripts/docs-check",
		"knip": "knip",
		"knip:report": "knip --no-exit-code",
		"prepare": "husky"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.13",
		"@commitlint/cli": "^21.2.3",
		"@commitlint/config-conventional": "^21.2.3",
		"@cspell/dict-pt-br": "^2.4.4",
		"@playwright/test": "^1",
		"@types/bun": "^1.4.3",
		"cspell": "^10",
		"dependency-cruiser": "^18.6.0",
		"husky": "^9",
		"knip": "^6",
		"lint-staged": "^17.6.0",
		"prettier": "^3",
		"prettier-plugin-sh": "^0.20.2",
		"typescript": "^7.0.2"
	}
}
